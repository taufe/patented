PORT=5001
MONGO_URI=
JWT_SECRET=

# Password-reset emails (required in production). Codes go to the account email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Manual payment account details (shown in GET /api/payments/methods)
JAZZCASH_ACCOUNT=03001234567
JAZZCASH_TITLE=Patented App
EASYPAISA_ACCOUNT=03001234567
EASYPAISA_TITLE=Patented App
BANK_ACCOUNT=PK00XXXX0000000000
BANK_TITLE=Patented App
BANK_NAME=HBL

# Plan prices in PKR
PLAN_WEEKLY_AMOUNT=700
PLAN_MONTHLY_AMOUNT=2000
PLAN_YEARLY_AMOUNT=18000

# Firebase Admin (FCM). Private key newlines as \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or paste the full service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# PDF learning materials stored in MongoDB GridFS. Default 15, max 50.
PDF_MAX_FILE_MB=15

# Optional public origin for profile photo URLs. Defaults to the incoming request host
# (https://patented.vercel.app in production, http://localhost:5001 locally).
# PUBLIC_BASE_URL=https://patented.vercel.app
